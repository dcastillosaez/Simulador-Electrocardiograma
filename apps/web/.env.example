# si mismo y el 7990-8089 cae dentro de uno en la maquina de desarrollo.
# `arrancar.bat` fija estas dos variables solo; este fichero documenta que
# hacen falta y con que forma.
VITE_API_BASE_URL=http://localhost:8200
VITE_WS_URL=ws://localhost:8200/ws/simulation
