{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@ui-system": ["../../packages/ui-system/index.ts"],
      "@ui-system/*": ["../../packages/ui-system/*"],
      // packages/ui-system vive fuera de apps/web y no tiene node_modules
      // propio (el repo no usa workspaces, a proposito): sin esto, tsc no
      // encuentra "vitest" al resolver css.test.ts porque la busqueda de
      // node_modules sube desde el fichero, no desde este tsconfig. Se
      // mapea solo "vitest" (no un catch-all "*"): un comodin amplio
      // rompe la resolucion normal de "react"/"react-dom" via exports/main.
      "vitest": ["./node_modules/vitest"],
      // Lo mismo para las dependencias que el ui-system comparte con la app.
      // Se apunta a los paquetes de tipos y no a los de runtime porque tsc
      // solo busca declaraciones: "react" no publica ninguna, y mapearlo a
      // ./node_modules/react dejaria el JSX sin tipar. Los alias equivalentes
      // para el bundler estan en vite.config.ts (SHARED_DEPS).
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@testing-library/*": ["./node_modules/@testing-library/*"]
    }
  },
  "include": ["src", "../../packages/ui-system"]
}
