{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simulador ECG",
  "version": "0.1.0",
  "identifier": "edu.simuladorecg.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5600",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Simulador de ECG",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Simulador ECG",
    "copyright": "Uso docente. No es un dispositivo médico.",
    "shortDescription": "Simulador de electrocardiograma para docencia",
    "longDescription": "Puesto de simulación clínica de ECG: doce derivaciones, ritmos normales y patológicos, medición sobre el trazado y farmacología. Herramienta docente; no está destinada al diagnóstico ni al tratamiento de pacientes.",
    "resources": {
      "../../api/packaging/dist/ecg-api": "ecg-api"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "signCommand": {
        "cmd": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-NoProfile",
          "-File",
          "../tools/firmar.ps1",
          "-Ruta",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMTAwOTQxQkExQTNDRjAKUldUd1BCcTZRUWtRd2ZHSVN6bXM2VFZ3NXZPdGxFZ1ZxeXFEKzc2M2g4c0tqdUZodFkvZnc1UlgK",
      "endpoints": [
        "https://ejemplo.invalid/simulador-ecg/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
