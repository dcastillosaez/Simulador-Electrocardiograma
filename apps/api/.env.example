# Copia este fichero a `.env` y ajusta lo que haga falta. El `.env` real está
# en .gitignore a propósito: nunca debe acabar en el repositorio.

DATABASE_URL=postgresql+asyncpg://ecg:ecg@localhost:5432/ecg_simulator
ENGINE_COMMIT=dev

# Orígenes desde los que se admite el frontend, separados por comas. Vale para
# las rutas REST (CORS) y para el handshake del WebSocket, que comprueba la
# cabecera `Origin` por su cuenta porque CORS no cubre el WS.
CORS_ORIGINS=http://localhost:5600,http://localhost:5173

# --- Aforo -------------------------------------------------------------------
# Un solo proceso sostiene todas las simulaciones, y cada una genera doce
# canales a 500 Hz: estos números son los que separan "el aula va lenta" de "el
# aula se queda sin servicio". Súbelos mirando la CPU de la máquina, no el
# número de alumnos.
MAX_WS_CONNECTIONS=50
MAX_WS_CONNECTIONS_PER_CLIENT=5
MAX_WS_MESSAGE_BYTES=65536

# Cuánto se espera a que una conexión recién abierta pida su primera
# simulación. Existe para que una pestaña olvidada acabe soltando su plaza, no
# para frenar a nadie: el frontend abre el socket al cargar y no manda `start`
# hasta que el usuario elige un ritmo, así que el plazo va holgado.
IDLE_START_TIMEOUT_S=300

# --- Proxy -------------------------------------------------------------------
# `true` SOLO si hay un proxy propio delante (ver deploy/Caddyfile). Hace que
# la API lea `X-Forwarded-For` para saber quién es cada cliente.
#
# Activarlo sin proxy delante es peor que no activarlo: esa cabecera la escribe
# cualquiera, y rotándola en cada conexión se consiguen plazas infinitas. Y con
# proxy delante, la API debe escuchar solo en 127.0.0.1, o cualquiera puede
# saltárselo y escribir la cabecera que quiera.
TRUST_PROXY=false
