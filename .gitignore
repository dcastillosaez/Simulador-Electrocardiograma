# Carpetas internas de Claude Code
.claude/

# Dependencias Node.js
node_modules/
dist/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/

# Ficheros temporales de Office
~$*

# Python
__pycache__/
*.pyc
*.pyo
**/.venv/

# Secretos. `.env.example` se versiona a proposito --documenta que variables
# hacen falta-- y el `.env` de verdad nunca: el dia que alguien escriba ahi las
# credenciales de una base de datos real, git no debe ofrecerselas para el
# commit.
.env
*.env
!.env.example

# Ficheros temporales de conversión de plantilla
_tmp_plantilla.docx

# Cache de Vite: artefacto local de desarrollo, se regenera solo.
# Anclado con ** porque este .gitignore esta en la raiz del monorepo y el
# proyecto vive en un subdirectorio: una ruta relativa no casaba con
# Simulador_Electrocardiograma/apps/web/.vite/ y el cache se colaba igual.
**/.vite/

# Config transpilada que Vite escribe junto a vite.config.ts cuando necesita
# cargarla. La borra sola al terminar, pero un proceso interrumpido las deja
# atras y acaban apareciendo como ficheros sin seguimiento.
vite.config.ts.timestamp-*

# Artefactos de empaquetado (fase G). Los produce el build, no se versionan.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/api/packaging/dist/
apps/api/packaging/build/

# Claves de firma. Nunca en el repositorio: la privada del updater y cualquier
# certificado viven fuera del arbol de fuentes.
*.key
*.pfx
*.p12
